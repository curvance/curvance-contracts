    /// @notice Pre-expiry, calling `redeemPyToToken` from a holder with PT
    ///         only (no YT) MUST revert — confirms the post-expiry pathway
    ///         is the ONLY safe path for our PT-only custody pattern, and
    ///         that wrapping in `if (isExpired())` is load-bearing.
    function test_EMPIRICAL_redeemPyToTokenPreExpiry_revertsWithoutYT()
        public
    {
        // No warp — fork block has PT pre-expiry.
        assertFalse(IPPrincipalToken(_PT_STETH).isExpired());

        address holder = address(this);
        uint256 ptAmount = 1 ether;
        _preparePT(holder, ptAmount);
        IERC20(_PT_STETH).approve(address(_ROUTER), ptAmount);

        TokenOutput memory output;
        output.tokenOut = _WSTETH;
        output.minTokenOut = 1;
        output.tokenRedeemSy = _WSTETH;

        address yt = IPPrincipalToken(_PT_STETH).YT();
        // Holder has zero YT.
        assertEq(IERC20(yt).balanceOf(holder), 0);

        // Pre-expiry, _redeemPyToSy attempts to pull both PT AND YT.
        // Holder has no YT → ERC20 transferFrom reverts.
        vm.expectRevert();
        _ROUTER.redeemPyToToken(holder, yt, ptAmount, output);
    }

    function _depositPtShares(address holder, uint256 ptAmount)
        internal
        returns (uint256 shares)
    {
        _preparePT(holder, ptAmount);

        vm.startPrank(holder);
        IERC20(_PT_STETH).approve(address(cPendlePTSTETH), ptAmount);
        shares = cPendlePTSTETH.deposit(ptAmount, holder);
        vm.stopPrank();

        assertGt(shares, 0, "cPT deposit MUST mint shares");
        assertEq(IERC20(_PT_STETH).balanceOf(holder), 0, "raw PT deposited");
    }

    function _callPtRedeemAndExit(
        PendleZapper zapper,
        address holder,
        uint256 shares,
        uint256 ptAmount,
        address pendleMarket
    ) internal returns (uint256 outAmount) {
        vm.startPrank(holder);
        cPendlePTSTETH.setDelegateApproval(address(zapper), true);
        outAmount = zapper.redeemAndExitPendle(
            _PT_STETH,
            address(_ROUTER),
            pendleMarket,
            true,
            _defaultPtExitAction(),
            _ptRedeemAction(shares),
            _ptExitZapAction(ptAmount),
            new SwapperLib.Swap[](0),
            holder
        );
        vm.stopPrank();
    }

    function _expectPtRedeemAndExitRevert(
        PendleZapper zapper,
        address holder,
        uint256 shares,
        uint256 ptAmount,
        address pendleMarket,
        bytes4 selector
    ) internal {
        vm.startPrank(holder);
        cPendlePTSTETH.setDelegateApproval(address(zapper), true);
        vm.expectRevert(selector);
        zapper.redeemAndExitPendle(
            _PT_STETH,
            address(_ROUTER),
            pendleMarket,
            true,
            _defaultPtExitAction(),
            _ptRedeemAction(shares),
            _ptExitZapAction(ptAmount),
            new SwapperLib.Swap[](0),
            holder
        );
        vm.stopPrank();
    }

    function _defaultPtExitAction()
        internal
        view
        returns (PendleLib.PendleAction memory action)
    {
        action.output.tokenOut = _WSTETH;
        action.output.minTokenOut = 1;
        action.output.tokenRedeemSy = _WSTETH;
    }

    function _ptRedeemAction(uint256 shares)
        internal
        view
        returns (BaseZapper.RedeemAction memory)
    {
        return BaseZapper.RedeemAction({
            cToken: address(cPendlePTSTETH),
            shares: shares,
            forceRedeemCollateral: false
        });
    }

    function _ptExitZapAction(uint256 ptAmount)
        internal
        view
        returns (PendleZapperMinimal.ZapAction memory zapAction)
    {
        zapAction.inputToken = _PT_STETH;
        zapAction.inputAmount = ptAmount;
        zapAction.outputToken = _WSTETH;
        zapAction.minimumOut = 1;
    }

    function _provideEnoughLiquidityForLeverage() internal {
        address liquidityProvider = makeAddr("liquidityProvider");

        _preparePT(liquidityProvider, 10 ether);
        _prepareDAI(liquidityProvider, 20000000e18);

        vm.startPrank(liquidityProvider);

        // Deposit borrowableCDAI.
        dai.approve(address(borrowableCDAI), 20000000 ether);
        borrowableCDAI.deposit(20000000 ether, liquidityProvider);

        // Deposit Curvance Pendle PT stETH.
        pendlePT.approve(address(cPendlePTSTETH), 10 ether);
        cPendlePTSTETH.deposit(10 ether, liquidityProvider);

        vm.stopPrank();
    }

    function _assertNoPositionManagerResidue() internal view {
        assertEq(dai.balanceOf(address(positionManager)), 0);
        assertEq(IERC20(_WSTETH).balanceOf(address(positionManager)), 0);
        assertEq(pendlePT.balanceOf(address(positionManager)), 0);
        assertEq(cPendlePTSTETH.balanceOf(address(positionManager)), 0);
    }
}

contract MockExactOutSwapTarget {
    function swap(
        address inputToken,
        address outputToken,
        uint256 inputAmount,
        uint256 outputAmount
    ) external {
        IERC20(inputToken).transferFrom(msg.sender, address(this), inputAmount);
        IERC20(outputToken).transfer(msg.sender, outputAmount);
    }
}

